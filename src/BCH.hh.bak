#ifndef BCH_hh
#define BCH_hh 1

#include "Operator.hh"

namespace BCH
{

    extern bool use_goose_tank_correction;
    extern bool use_brueckner_bch;
    extern bool bch_skip_ieq1;
    extern bool use_factorized_correction;
    extern bool use_factorized_correction_BCH_Product;
    extern bool use_factorized_correct_ZBterm;
    extern bool only_2b_omega;
    extern bool TurnOn_comm223_231;
    extern bool TurnOn_comm223_232;


    extern double bch_transform_threshold;
    extern double bch_product_threshold;



    Operator BCH_Product(Operator &X, Operator &Y);
    Operator BCH_Transform(const Operator &Op, const Operator &Omega);
    // Ordered exp(OmegaOuter) exp(OmegaInner) transformation, including the
    // factorized 223->23{1,2} return across the boundary between exponentials.
    Operator BCH_Transform(const Operator &Op, const Operator &OmegaOuter, const Operator &OmegaInner);
    // Three stages: inner G1, middle G2, outer small hunter.
    Operator BCH_Transform(const Operator &Op, const Operator &OmegaOuter,
                           const Operator &OmegaMiddle, const Operator &OmegaInner);
    // Cache the inner transform and its TWO-BODY source S=sum_k N_k/(k+1)!.
    // [OmegaInner,S]_3 represents the discarded three-body component; no
    // three-body matrix elements are constructed by these routines.
    std::pair<Operator, Operator> BCH_TransformWithSource(const Operator &Op, const Operator &Omega);
    // Transform with an incoming virtual source; returns ONLY the new source
    // for Omega. The caller must retain the incoming (OmegaInner, Source) pair.
    std::pair<Operator, Operator> BCH_TransformWithSource(const Operator &Op, const Operator &Omega,
                                                       const Operator &OmegaInner, const Operator &Source);
    Operator BCH_TransformFromSource(const Operator &Transformed, const Operator &OmegaOuter,
                                    const Operator &OmegaInner, const Operator &Source);
    Operator BCH_TransformFromSources(const Operator &Transformed, const Operator &OmegaOuter,
                                     const Operator &OmegaInner1, const Operator &Source1,
                                     const Operator &OmegaInner2, const Operator &Source2);
    Operator Standard_BCH_Transform(const Operator &Op, const Operator &Omega);
    Operator Brueckner_BCH_Transform(const Operator &Op, const Operator &Omega);

    double EstimateBCHError(Operator &Omega, Operator H);

    Operator GooseTankUpdate(const Operator &Omega, const Operator &Nested);


    void SetUseBruecknerBCH(bool tf);
    void SetUseGooseTank(bool tf);
    void SetBCHSkipiEq1(bool tf);
    void SetUseFactorizedCorrection(bool tf);
    void SetUseFactorizedCorrectionBCH_product(bool tf);
    void SetUseFactorized_Correct_ZBTerm(bool tf);
    void SetOnly2bOmega(bool tf);

    void SetComm223_231(bool tf);
    void SetComm223_232(bool tf);

    void Set_BCH_Transform_Threshold(double x);
    void Set_BCH_Product_Threshold(double x);

    std::tuple<Operator, Operator> BCH_ProductPV(Operator &X, Operator &XPV, Operator &Y, Operator &YPV);
    std::tuple<Operator, Operator> BCH_TransformPV(const Operator &Op,const Operator &OpPV, const Operator &Omega, const Operator &OmegaPV);
    std::tuple<Operator, Operator> BCH_TransformHPV(const Operator &Op,const Operator &OpPV, const Operator &Omega, const Operator &OmegaPV);
    std::tuple<Operator, Operator> Standard_BCH_TransformPV(const Operator &Op,const Operator &OpPV, const Operator &Omega, const Operator &OmegaPV);
    std::tuple<Operator, Operator> Standard_BCH_TransformHPV(const Operator &Op, const Operator &OpPV, const Operator &Omega, const Operator &OmegaPV);

}// namespace BCH

#endif
